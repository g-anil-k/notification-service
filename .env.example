# ROLE: all (API + worker in one process) | api | worker
ROLE=all
PORT=3000

# BROKER: memory | rabbitmq        STORE: memory | postgres
BROKER=memory
STORE=memory
RABBITMQ_URL=amqp://guest:guest@localhost:5672
DATABASE_URL=postgres://notify:notify@localhost:5432/notify

# Retry policy: delay before attempt N+1 = RETRY_BASE_DELAY_MS * 2^(N-1)
MAX_ATTEMPTS=4
RETRY_BASE_DELAY_MS=2000

# Demo: 0.5 = half of all sends fail transiently, so you can watch retries and the DLQ
MOCK_FAILURE_RATE=0

# Optional real SMTP (otherwise emails are logged to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
